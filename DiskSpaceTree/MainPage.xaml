<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DiskSpaceTree.ViewModels"
             xmlns:controls="clr-namespace:DiskSpaceTree.Controls"
             x:Class="DiskSpaceTree.MainPage">

    <ContentPage.BindingContext>
        <vm:MainViewModel />
    </ContentPage.BindingContext>

    <ContentPage.Resources>
        <converters:InvertedBoolConverter x:Key="InvertedBoolConverter" xmlns:converters="clr-namespace:DiskSpaceTree.Converters" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
        <Label Text="Disk Space Tree"
               Style="{StaticResource Headline}"
               HorizontalOptions="Center"
               Margin="0,10,0,0" />

        <VerticalStackLayout Grid.Row="1"
                             Spacing="10"
                             Padding="20,10"
                             HorizontalOptions="Center"
                             WidthRequest="400">
            <Label Text="Select a disk drive to scan:" />
            <Picker ItemsSource="{Binding Drives}"
                    SelectedItem="{Binding SelectedDrive}"
                    ItemDisplayBinding="{Binding Name}"
                    Title="Disk Drive" />
            <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                <Button Text="Scan"
                        Command="{Binding ScanSelectedDriveCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />
                <Button Text="Cancel"
                        Command="{Binding CancelCommand}"
                        IsEnabled="{Binding IsBusy}" />
            </HorizontalStackLayout>
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}" />
            <Label Text="{Binding StatusMessage}"
                   VerticalOptions="Center"
                   FontSize="12" />
        </VerticalStackLayout>

        <controls:TreeView Grid.Row="3"
                           ItemsSource="{Binding RootNodes}"
                           VerticalOptions="Fill"
                           Margin="10,0,10,10" />

        <Grid Grid.Row="4"
              ColumnDefinitions="*,Auto"
              BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray900}}"
              Padding="10,5"
              IsVisible="{Binding IsBusy}">
            <Label Text="{Binding CurrentFilePath}"
                   Grid.Column="0"
                   FontSize="12"
                   LineBreakMode="TailTruncation"
                   VerticalOptions="Center" />
            <Label Text="{Binding FilesProcessed, StringFormat='Files: {0:N0}'}"
                   Grid.Column="1"
                   FontSize="12"
                   VerticalOptions="Center" />
        </Grid>
    </Grid>

</ContentPage>
