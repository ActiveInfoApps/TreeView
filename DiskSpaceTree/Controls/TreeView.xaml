<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DiskSpaceTree.ViewModels"
             xmlns:local="clr-namespace:DiskSpaceTree.Controls"
             xmlns:converters="clr-namespace:DiskSpaceTree.Converters"
             xmlns:behaviors="clr-namespace:DiskSpaceTree.Behaviors"
             x:Class="DiskSpaceTree.Controls.TreeView"
             x:Name="RootTreeView">

    <ContentView.Resources>
        <converters:IndentConverter x:Key="IndentConverter" IndentSize="20" />
        <DataTemplate x:Key="TreeViewItemTemplate" x:DataType="vm:TreeViewItem">
            <Grid ColumnDefinitions="Auto,*,Auto"
                  Padding="10,5"
                  BackgroundColor="Transparent">
                <Grid.Behaviors>
                    <behaviors:OpenInExplorerBehavior />
                </Grid.Behaviors>
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ToggleCommand}" />
                </Grid.GestureRecognizers>

                <HorizontalStackLayout Spacing="5"
                                       Padding="{Binding Level, Converter={StaticResource IndentConverter}}">
                    <Label Text="{Binding ExpandCollapseIcon}"
                           IsVisible="{Binding IsDirectory}"
                           VerticalOptions="Center"
                           FontSize="12"
                           TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}" />

                    <Label Text="{Binding DisplayText}"
                           VerticalOptions="Center"
                           LineBreakMode="TailTruncation">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding HasError}" Value="True">
                                <Setter Property="TextColor" Value="Red" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </HorizontalStackLayout>

                <Label Text="{Binding DisplaySize}"
                       Grid.Column="2"
                       VerticalOptions="Center"
                       FontSize="12"
                       TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}" />
            </Grid>
        </DataTemplate>
    </ContentView.Resources>

    <Grid VerticalOptions="Fill"
          BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}">
        <ScrollView VerticalOptions="Fill">
            <StackLayout x:Name="ItemsStackLayout"
                         BindableLayout.ItemTemplate="{StaticResource TreeViewItemTemplate}"
                         Spacing="0" />
        </ScrollView>

        <Label Text="No directories to display. Select a drive and tap Scan."
               HorizontalOptions="Center"
               VerticalOptions="Center"
               Padding="20"
               IsVisible="{Binding Source={x:Reference RootTreeView}, Path=IsEmpty}" />
    </Grid>

</ContentView>
